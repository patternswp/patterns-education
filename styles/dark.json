{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Dark",
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#212529",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#fff",
					"name": "Default",
					"slug": "default"
				},
				{
					"color": "#343A40",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#DEE2E6",
					"name": "Secondary",
					"slug": "secondary"
				},
				{
					"color": "#f3f4fd",
					"name": "Tertiary",
					"slug": "tertiary"
				},
				{
					"color": "#6C757D",
					"name": "Quaternary",
					"slug": "quaternary"
				},
				{
					"_comment": "add color palette in sidebar inspector & also auto create css variable i.e --wp--preset--color--{slug} = --wp--preset--color--quinary",
					"color": "#f6f7f9",
					"name": "Senary",
					"slug": "senary"
				},
				{
					"color": "#6C757D",
					"name": "Accent",
					"slug": "accent"
				}
			],
			"duotone": [
				{
					"colors": ["#212529", "#212529"],
					"slug": "base",
					"name": "Base"
				},
				{
					"colors": ["#fff", "#fff"],
					"slug": "default",
					"name": "Default"
				},
				{
					"colors": ["#343A40", "#343A40"],
					"slug": "primary",
					"name": "Primary"
				},
				{
					"colors": ["#0F0F0F", "#0F0F0F"],
					"slug": "secondary",
					"name": "Secondary"
				},
				{
					"colors": ["#f3f4fd", "#f3f4fd"],
					"slug": "tertiary",
					"name": "Tertiary"
				},
				{
					"colors": ["#6C757D", "#6C757D"],
					"slug": "quaternary",
					"name": "Quaternary"
				},
				{
					"colors": ["#6C757D", "#6C757D"],
					"slug": "quinary",
					"name": "Quinary"
				},
				{
					"colors": ["#f6f7f9", "#f6f7f9"],
					"slug": "senary",
					"name": "Senary"
				},

				{
					"colors": ["#6C757D", "#6C757D"],
					"slug": "accent",
					"name": "Accent"
				}
			]
		}
	},
	"styles": {
		"elements": {
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|default"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|base"
					}
				},
				":focus": {
					"color": {
						"background": "var:preset|color|base"
					}
				},
				":active": {
					"color": {
						"background": "var:preset|color|base"
					}
				},
				":visited": {
					"color": {
						"text": "var:preset|color|default"
					}
				}
			},

			"link": {
				":active": {
					"color": {
						"text": "var:preset|color|primary"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "var(--wp--preset--color--primary) !important"
						},
						"color": {
							"text": "var:preset|color|primary"
						},
						"elements": {
							"link": {
								":hover": {
									"border": {
										"color": "var:preset|color|primary"
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
